          }
        }
      }
    },
    "Counts reset when the backend restarts. The latest retained reading can come from an earlier session." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zähler werden beim Neustart des Servers zurückgesetzt. Der letzte gespeicherte Messwert kann aus einer früheren Sitzung stammen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los contadores se reinician al arrancar el servidor local. La última medición guardada puede ser de una sesión anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les compteurs repartent à zéro au redémarrage du serveur local. Le dernier relevé conservé peut venir d’une session précédente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I contatori si azzerano quando il server riparte. L’ultima rilevazione conservata può risalire a una sessione precedente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックエンドが再起動するとカウンタはリセットされます。最新の記録が前のセッションのものである場合があります。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os contadores são zerados ao reiniciar o servidor. A última leitura mantida pode ser de uma sessão anterior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后端重启时计数会重置。最新保留的记录可能来自之前的会话。"
