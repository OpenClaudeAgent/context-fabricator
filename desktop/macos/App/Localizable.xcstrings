    "This deletes all retained local code, history, Actions and graph data for this repository, including its other branches. Settings remain. Collection pauses until you explicitly refresh an enabled, verified feature." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle lokal gespeicherten Dateien, Verlaufs-, Actions- und Graphdaten dieses Repositorys einschließlich seiner anderen Branches gelöscht. Die Einstellungen bleiben erhalten. Die Erfassung bleibt angehalten, bis du eine aktivierte und überprüfte Funktion manuell aktualisierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todo el código, el historial, los datos de Actions y el grafo conservados localmente para este repositorio y sus demás ramas. Se conservan los ajustes. La recopilación no se reanudará hasta que actualices una función activa y verificada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime le code, l’historique, les données Actions et le graphe conservés localement pour ce dépôt et toutes ses branches. Les réglages sont conservés. Pour reprendre la collecte, actualisez une fonctionnalité activée et vérifiée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione elimina tutto il codice, la cronologia, i dati di Actions e il grafo conservati in locale per questo repository e per gli altri rami. Le impostazioni vengono conservate. La raccolta resta in pausa finché non aggiorni una funzione attiva e verificata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリポジトリの他のブランチを含め、ローカルに保持されたコード、履歴、Actions、グラフのデータをすべて削除します。設定は保持されます。有効でアクセス確認済みの機能を手動で更新するまで、収集は一時停止します。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso exclui o código, o histórico, os dados do Actions e o grafo mantidos localmente para este repositório e seus outros ramos. Os ajustes são mantidos. A coleta fica pausada até que você atualize um recurso ativo e verificado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将删除此仓库（含其他分支）在本地保留的代码、历史、Actions 和图谱数据。设置将保留。采集会暂停，直至你手动刷新已启用且已验证的功能。"
          }
        }
      }
    },
    "This deletes saved questions and answers and turns off history." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden gespeicherte Fragen und Antworten gelöscht und der Verlauf wird deaktiviert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina las preguntas y respuestas guardadas y desactiva el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime les questions et réponses enregistrées et désactive l’historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione elimina le domande e le risposte salvate e disattiva la cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した質問と回答を削除し、履歴をオフにします。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso exclui perguntas e respostas salvas e desativa o histórico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将删除已保存的问题和回答，并关闭历史保存。"
          }
        }
      }
    },
    "This removes embedding vectors. Your documents and lexical search remain available. The index can be rebuilt when enabled." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden Einbettungsvektoren entfernt. Deine Dokumente und die lexikalische Suche bleiben verfügbar. Ein aktivierter Index kann neu erstellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina los vectores de embeddings. Los documentos y la búsqueda léxica siguen disponibles. Puedes reconstruir el índice al activarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime les vecteurs d’embedding. Vos documents et la recherche lexicale restent accessibles. L’index peut être reconstruit si vous le réactivez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione rimuove i vettori degli embedding. I documenti e la ricerca lessicale restano disponibili. Puoi ricostruire l’indice quando lo attivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "埋め込みベクトルを削除します。ドキュメントとキーワード検索は引き続き利用できます。インデックスは有効化後に再作成できます。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove vetores de embeddings. Seus documentos e a busca lexical continuam disponíveis. Você pode reconstruir o índice ao ativá-lo."
