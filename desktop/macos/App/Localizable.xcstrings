          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les dépôts privés, coche la permission repo sur GitHub."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per i repository privati, seleziona l’ambito repo su GitHub."
          }
