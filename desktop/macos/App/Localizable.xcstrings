          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para repositórios privados, selecione o escopo repo no GitHub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于私有仓库，请在 GitHub 上选择 repo 权限范围。"
          }
        }
      }
    },
    "If your organization uses SAML, use Configure SSO to authorize the classic token." : {
