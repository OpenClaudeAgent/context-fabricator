    "For a fine-grained token, select the repository and its owner on GitHub." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle für ein detailliertes Token das Repository und seinen Eigentümer auf GitHub aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para un token de acceso específico, selecciona el repositorio y su propietario en GitHub."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un jeton à accès granulaire, sélectionne le dépôt et son propriétaire sur GitHub."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per un token con accesso granulare, seleziona il repository e il suo proprietario su GitHub."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "きめ細かいトークンの場合は、GitHub でリポジトリとその所有者を選択してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para um token com acesso granular, selecione o repositório e seu proprietário no GitHub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于细粒度令牌，请在 GitHub 上选择仓库及其所有者。"
          }
        }
      }
    },
    "For private repositories, select the repo scope on GitHub." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
