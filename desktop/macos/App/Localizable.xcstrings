    "Check the branch, the token’s Resource owner and read permissions, and any pending organization approval." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe den Branch, „Resource owner“ und die Leserechte des Tokens sowie eine eventuell ausstehende Genehmigung durch die Organisation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba la rama, el «Resource owner» y los permisos de lectura del token. Revisa si hay una aprobación pendiente de la organización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez la branche, le « Resource owner » et les droits de lecture du jeton, ainsi que toute approbation en attente auprès de l’organisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla il ramo, il «Resource owner» e i permessi di lettura del token, nonché eventuali approvazioni in attesa da parte dell’organizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブランチ、トークンの「Resource owner」と読み取り権限、組織の承認待ちの有無を確認してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique o ramo, o «Resource owner» e as permissões de leitura do token, bem como qualquer aprovação pendente da organização."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查分支、令牌的「Resource owner」和读取权限，以及组织是否还有待处理的审批。"
          }
        }
      }
    },
    "Replacing the token can affect access to repositories under other owners." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ersetzen des Tokens kann den Zugriff auf Repositorys anderer Eigentümer beeinträchtigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplazar el token puede afectar al acceso a repositorios de otros propietarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le remplacement du jeton peut affecter l’accès aux dépôts d’autres propriétaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sostituzione del token può influire sull’accesso ai repository di altri proprietari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークンを変更すると、他の所有者のリポジトリにアクセスできなくなる場合があります。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
